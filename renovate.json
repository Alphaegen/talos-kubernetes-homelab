{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests"
  ],
  "dependencyDashboardApproval": false,
  "prCreation": "immediate",
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update Helm chart versions annotated with '# renovate:' comments",
      "managerFilePatterns": [
        "/(^|/)gitops/.+\\.ya?ml$/"
      ],
      "matchStrings": [
        "#\\s*renovate:\\s*datasource=(?<datasource>\\S+)\\s+depName=(?<depName>\\S+)(?:\\s+registryUrl=(?<registryUrl>\\S+))?(?:\\s+versioning=(?<versioning>\\S+))?\\s*\\n\\s*version:\\s*[\"']?(?<currentValue>[^\"'\\s]+)[\"']?"
      ],
      "versioningTemplate": "{{#if versioning}}{{{versioning}}}{{else}}semver{{/if}}"
    },
    {
      "customType": "regex",
      "description": "Update CI tool versions annotated with '# renovate:' comments in workflow env",
      "managerFilePatterns": [
        "/(^|/)\\.github/workflows/.+\\.ya?ml$/"
      ],
      "matchStrings": [
        "#\\s*renovate:\\s*datasource=(?<datasource>\\S+)\\s+depName=(?<depName>\\S+)\\s*\\n\\s*[A-Z0-9_]+_VERSION:\\s*[\"']?(?<currentValue>[^\"'\\s]+)[\"']?"
      ]
    },
    {
      "customType": "regex",
      "description": "Update git commit pins annotated with '# renovate: datasource=git-refs' comments in scripts",
      "managerFilePatterns": [
        "/(^|/)scripts/.+\\.sh$/"
      ],
      "matchStrings": [
        "#\\s*renovate:\\s*datasource=(?<datasource>git-refs)\\s+depName=(?<depName>\\S+)\\s+branch=(?<currentValue>\\S+)\\s*\\n[a-z_]+=(?<currentDigest>[0-9a-f]{40})"
      ]
    }
  ],
  "helm-values": {
    "managerFilePatterns": [
      "/(^|/)gitops/infra-helm/values\\.ya?ml$/",
      "/(^|/)gitops/argocd/helm-values\\.ya?ml$/",
      "/(^|/)gitops/infra-custom/.+/(?:values|[^/]+-values)\\.ya?ml$/"
    ]
  },
  "kubernetes": {
    "managerFilePatterns": [
      "/(^|/)gitops/infra-custom/.+\\.ya?ml$/"
    ]
  },
  "packageRules": [
    {
      "description": "Parse LinuxServer application and image build versions",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "lscr.io/linuxserver/prowlarr",
        "lscr.io/linuxserver/radarr",
        "lscr.io/linuxserver/sonarr"
      ],
      "versioning": "regex:^(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)\\.(?<build>\\d+)-ls(?<revision>\\d+)$"
    },
    {
      "description": "Parse LinuxServer Bazarr application and image build versions",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "lscr.io/linuxserver/bazarr"
      ],
      "versioning": "regex:^v(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)-ls(?<build>\\d+)$"
    },
    {
      "description": "Parse qBittorrent Enhanced Edition release tags",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "sxyzy1016/qbittorrent-enhanced-edition"
      ],
      "versioning": "regex:^release-(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)\\.(?<build>\\d+)$"
    },
    {
      "description": "Track both Go and Alpine versions in the builder image",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "golang"
      ],
      "versioning": "regex:^(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)-alpine(?<build>\\d+)\\.(?<revision>\\d+)$"
    },
    {
      "description": "Group routine Helm updates while keeping major upgrades isolated",
      "matchDatasources": [
        "helm"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin",
        "digest"
      ],
      "groupName": "helm chart updates"
    },
    {
      "description": "Group routine container updates while keeping major upgrades isolated",
      "matchDatasources": [
        "docker"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin",
        "digest"
      ],
      "groupName": "container image updates"
    },
    {
      "description": "The private smoke image is released by this repository and is not anonymously queryable",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "ghcr.io/alphaegen/homelab-platform-smoke"
      ],
      "enabled": false
    },
    {
      "description": "Group routine GitHub Actions and CI tool updates while keeping major upgrades isolated",
      "matchManagers": [
        "github-actions",
        "custom.regex"
      ],
      "matchFileNames": [
        ".github/workflows/**"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin",
        "digest"
      ],
      "groupName": "CI updates"
    },
    {
      "description": "The CRDs catalog moves often; refresh the schema pin in its own weekly PR",
      "matchDepNames": [
        "https://github.com/datreeio/CRDs-catalog"
      ],
      "schedule": [
        "before 6am on monday"
      ]
    },
    {
      "description": "Cilium is applied by hand, not by Argo CD; keep it out of the routine groups above",
      "matchFileNames": [
        "cilium/**"
      ],
      "groupName": "Cilium (manual apply)",
      "groupSlug": "cilium-manual-apply",
      "addLabels": [
        "manual-apply"
      ],
      "prBodyNotes": [
        "> [!WARNING]\n> **Manual apply.** Merging does NOT deploy Cilium. Follow `cilium/README.md` (Gateway API prerequisite, render, diff, preflight, apply) and refresh `cilium/crds/` from the matching upstream tag per `cilium/crds/SOURCE.md`."
      ]
    },
    {
      "description": "Argo CD is applied by hand; keep chart and image in one PR, including major updates",
      "matchFileNames": [
        "gitops/argocd/**"
      ],
      "groupName": "Argo CD (manual apply)",
      "groupSlug": "argocd-manual-apply",
      "separateMajorMinor": false,
      "addLabels": [
        "manual-apply"
      ],
      "prBodyNotes": [
        "> [!WARNING]\n> **Manual apply.** Merging does NOT upgrade Argo CD. Keep `global.image.tag` equal to the chart appVersion, then apply per `docs/bootstrap.md` (Bootstrap Argo CD manually).\n>\n> When the Argo CD version changes, set `HELM_VERSION` and `KUSTOMIZE_VERSION` in `.github/workflows/validate.yaml` to the versions in that release's `hack/tool-versions.sh`, so CI renders like the cluster."
      ]
    },
    {
      "description": "Talos is upgraded by hand; move the talosctl CLI and the etcd-backup talosctl image together",
      "matchDepNames": [
        "talosctl",
        "ghcr.io/siderolabs/talosctl"
      ],
      "groupName": "Talos (manual apply)",
      "groupSlug": "talos-manual-apply",
      "addLabels": [
        "manual-apply"
      ],
      "prBodyNotes": [
        "> [!WARNING]\n> **Manual apply.** Merge only after the nodes run this Talos version (`docs/control-plane-recovery.md`, Upgrade command pattern). Merging does NOT upgrade Talos, but Argo CD will roll out the etcd-backup talosctl image."
      ]
    }
  ],
  "rangeStrategy": "pin",
  "labels": [
    "dependencies",
    "gitops"
  ],
  "prConcurrentLimit": 10
}
